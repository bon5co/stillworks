package audit

import (
	"fmt"
	"time"
)

// crumbs is the visible breadcrumb on a page one level below the shelf. The
// JSON-LD BreadcrumbList says the same thing to a crawler; this says it to a
// person, and puts a crawlable link to the shelf on every guide.
templ crumbs(here string) {
	<nav class="muted small" aria-label="Breadcrumb">
		<a href="/">stillworks</a> / { here }
	</nav>
}

// KeylessPage answers "free LLM API with no key". Its table is rendered on the
// server from the same rows as the shelf, so what a crawler reads is what a
// visitor reads, and every number on it is a count over a window it names.
templ KeylessPage(def pageDef, entries []keylessEntry, working []WorkingModel, sweep *time.Time, origin string) {
	@masthead(sweep)
	<div class="sw">
		@crumbs(def.Short)
		<h1>{ def.Heading }</h1>
		<p class="lede">
			{ fmt.Sprintf("%s answering with no API key right now, from %d of the %s we track.",
				countOf(len(working), "model"), answeringProviders(entries), countOf(len(entries), "no-key provider")) }
			Each was called with a real chat request carrying <b>no Authorization header at all</b>,
			and the result below is what came back, not what the provider's page says.
		</p>
		<p class="muted measure">
			Last answer on this page: { humanWhenPtr(sweep) }. The prober calls every endpoint hourly and
			publishes the refusals along with the successes, because a free endpoint that
			answered at noon and returned <code>429</code> at one is the normal case, not the exception.
		</p>
		<h2>No-key endpoints and their track record</h2>
		<div class="scroll">
			<table>
				<thead>
					<tr>
						<th>Provider</th>
						<th>Models answering</th>
						<th>Chat calls answered (14 days)</th>
						<th>Median reply</th>
						<th>Last answer</th>
					</tr>
				</thead>
				<tbody>
					for _, entry := range entries {
						<tr>
							<td>
								<a href={ templ.SafeURL(providerPath(entry.Row.Slug)) }>{ entry.Row.Provider }</a>
								if !entry.Row.OpenAICompatible {
									<span class="muted small"> (Ollama-shaped, not OpenAI-compatible)</span>
								}
							</td>
							<td>{ fmt.Sprintf("%d of %d listed", entry.Row.WorkingModels, entry.Row.ModelsListed) }</td>
							<td>
								if entry.Track.Attempts > 0 {
									{ fmt.Sprintf("%d of %d (%.0f%%)", entry.Track.Answered, entry.Track.Attempts, entry.Track.Rate()) }
								} else {
									—
								}
							</td>
							<td class="when">{ latency(entry.Track.MedianMS) }</td>
							<td class="when">
								if entry.Best != nil {
									{ humanWhenPtr(entry.Best.LastOK) }
								} else {
									no model answering
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="muted small scroll-note">Scroll the table sideways for the rest of each row.</p>
		<h2>Call one now</h2>
		if len(working) > 0 {
			<p class="muted measure">
				This is the model the API would return first, ranked by recent success rate then latency. It
				{ reliabilitySentence(working[0].Successes, working[0].Attempts) }, last
				{ humanWhenPtr(working[0].LastOK) }, from this server's address.
			</p>
			@copyable("as curl", snippet(working[0]))
			if working[0].OpenAICompatible {
				@copyable("as .env", EnvLines(working[0]))
			}
		} else {
			<p class="warn measure">
				No keyless model is verified right now, so there is no call here we would stand behind.
				That is the state this page exists to report, and it is not hidden.
			</p>
		}
		<p class="measure">
			Do not hardcode that model. Ask for whatever is answering at the moment you run:
			<code>{ "curl -s " + origin + "/api/llm/up" }</code>. The
			<a href="/docs">reference</a> lists the parameters.
		</p>
		<h2>What "no API key" means here</h2>
		<p class="measure">
			A keyless endpoint is one that answers a chat completion with no <code>Authorization</code>
			header, no account, no card and no phone number. That is a stricter test than most lists apply.
			The shape most often mistaken for it is a catalogue that answers <code>GET /v1/models</code>
			with <code>200</code> to anybody and then answers the chat call <code>401</code>: the listing
			is open and the endpoint is not. We call the chat route, so that shape does not get through.
		</p>
		<h2>Why a no-key endpoint can still refuse you</h2>
		<p class="measure">
			Keyless quotas are usually per IP address. An endpoint that answered this server can answer
			<code>429</code> or <code>402</code> from yours, and any of them can add a key requirement
			between two of our probes. That is why the shelf is ranked and the API returns a list:
			take the first, and on a refusal take the next. The loop is on the
			<a href="/docs">reference page</a> in Python, Node and curl.
		</p>
		<h2>Checked and not listed</h2>
		<p class="measure muted">
			These are endpoints another catalogue types as needing no key, and the call that ended each
			one here. A directory is judged on its rows and silently on the claims it never shows.
		</p>
		<dl class="rejects">
			for _, claim := range RejectedClaims {
				<dt>{ claim.Name } <code>{ claim.Endpoint }</code></dt>
				<dd>{ claim.Verdict }</dd>
			}
		</dl>
		<p>
			<a href="/">The whole shelf, including providers that need a key of your own</a> ·
			<a href="/free-llm-api-resources-alternatives">How this compares with the GitHub lists</a>
		</p>
		@siteFooter()
	</div>
}

// AlternativesPage is the comparison page: it names what people already search
// for and says what a list can and cannot tell you, from numbers we hold.
templ AlternativesPage(def pageDef, data alternativesData, origin string) {
	@masthead(nil)
	<div class="sw">
		@crumbs(def.Short)
		<h1>{ def.Heading }</h1>
		<p class="lede">
			Search for free LLM API resources and you land on GitHub lists and directory sites. They
			are useful for finding providers, and every one of them is a snapshot. The list people
			name most, <code>cheahjs/free-llm-api-resources</code>, answered <code>404</code> on
			12 October 2026 when we fetched it, and a search for its name returns forks whose
			last commits run from August 2024 to this week.
		</p>
		<p class="muted measure">
			That is not a complaint about the people who kept those lists. It is what a list is:
			a person's reading of provider pages on the day they read them. This page says what the
			reading cannot tell you, and what an hourly call adds.
		</p>
		<h2>What a list tells you, and what a probe tells you</h2>
		<div class="scroll">
			<table>
				<thead>
					<tr><th>Question</th><th>A list of resources</th><th>An hourly probe</th></tr>
				</thead>
				<tbody>
					<tr>
						<td>Which providers offer a free tier?</td>
						<td>Yes: this is what lists are for, and they cover far more providers than we do.</td>
						<td>{ fmt.Sprintf("Only the %d we track.", data.Providers) }</td>
					</tr>
					<tr>
						<td>What quota does the provider publish?</td>
						<td>Yes, as of the day it was copied.</td>
						<td>No. We do not restate a limit; we count the refusals we received.</td>
					</tr>
					<tr>
						<td>Did a real call answer in the last hour?</td>
						<td>No.</td>
						<td>Yes, with the time it answered.</td>
					</tr>
					<tr>
						<td>What was the refusal: rate limit, spent budget or missing key?</td>
						<td>No.</td>
						<td>Yes: each probe records the outcome and the HTTP status.</td>
					</tr>
					<tr>
						<td>Does tool calling or JSON schema actually work?</td>
						<td>As claimed by the provider.</td>
						<td>Proved by a call that parsed, or marked as claimed and not proved.</td>
					</tr>
					<tr>
						<td>Can a program ask?</td>
						<td>Scrape a README.</td>
						<td>
							<code>GET /api/llm/up</code>, JSON, no key. See the <a href="/docs">reference</a>.
						</td>
					</tr>
				</tbody>
			</table>
		</div>
		<h2>What the probing has found so far</h2>
		<ul class="measure">
			<li>
				{ fmt.Sprintf("%s were recorded across %s in the last %d days.",
					countOf(data.Calls14d, "probe"), countOf(data.Providers, "endpoint"), TrackWindowDays) }
			</li>
			<li>
				{ fmt.Sprintf("Right now %s answer with no key and %s more answer our own free-tier key.",
					countOf(data.KeylessModels, "model"), countOf(data.KeyedModels, "model")) }
			</li>
			<li>
				{ fmt.Sprintf("We cross-checked the no-key claims in a 226-provider routing registry by calling them. %s did not hold and are listed, with the call that ended each, on the", countOf(data.Rejected, "claim")) }
				<a href="/free-llm-api-no-key">no-key page</a>.
			</li>
			<li>
				The most common false positive is a catalogue that lists its models without a key and
				answers the chat call <code>401</code>. A list built from reading provider pages cannot
				see that; a call can.
			</li>
		</ul>
		<h2>When a list is still the right tool</h2>
		<p class="measure">
			To discover providers we do not track, use a list: ours is short on purpose, because every
			provider on it is called hourly and a long list we could not keep checking would be the
			thing we are criticising. Our own limits are written on every row. The key-required rows
			were measured with <em>our</em> free-tier key, which says the endpoint answered our account
			and nothing about what a new signup receives.
		</p>
		<h2>Using both</h2>
		<ol class="measure">
			<li>Find candidates in a list.</li>
			<li>
				Ask what is answering now:
				<code>{ "curl -s " + origin + "/api/llm/up" }</code>. Add
				<code>?key=any</code> to include providers that need your own key.
			</li>
			<li>
				Open the provider's page for its probe log and its last refusal before you build on it:
				<a href="/llm/groq">Groq</a>, <a href="/llm/openrouter">OpenRouter</a>,
				<a href="/llm/mistral">Mistral</a>, or the
				<a href="/free-llm-api-no-key">no-key providers</a>.
			</li>
		</ol>
		<p><a href="/">Open the live shelf</a></p>
		@siteFooter()
	</div>
}

// DocsPage is the reference for the runtime API. The example response is the
// live top row, so the page cannot describe fields the API does not return.
templ DocsPage(def pageDef, example string, origin string) {
	@masthead(nil)
	<div class="sw">
		@crumbs("API reference")
		<h1>{ def.Heading }</h1>
		<p class="lede">
			Ask which free LLM endpoint answered recently, and get back the base URL, the model id, whether
			a key is needed and what a real call proved. No key, no signup. The list is ranked, so
			<code>models[0]</code> is the pick and the rest are your fallbacks.
		</p>
		<h2>Quick start</h2>
		@copyable("as curl", "curl -s "+origin+"/api/llm/up")
		<p class="muted measure">
			Any client that speaks the OpenAI chat-completions shape can use what comes back. Or get
			the three environment variables directly:
		</p>
		@copyable("as curl", "curl -s "+origin+"/api/llm/up?format=env")
		<h2>Walk the list until one answers</h2>
		<p class="measure">
			Keyless quotas are per IP, so the endpoint that answered us can refuse you. The pattern is a loop.
		</p>
		@copyable("as python", fallbackLoop("python", origin))
		@copyable("as node", fallbackLoop("js", origin))
		<h2>Parameters</h2>
		<div class="scroll">
			<table>
				<thead><tr><th>Parameter</th><th>Values</th><th>Effect</th></tr></thead>
				<tbody>
					<tr>
						<td><code>key</code></td>
						<td><code>none</code> (default), <code>key</code>, <code>any</code></td>
						<td>
							<code>none</code> returns only endpoints that answered with no Authorization header.
							<code>key</code> and <code>any</code> add providers that need your own key, each row labelled.
							<code>auth</code> is the older spelling and still works.
						</td>
					</tr>
					<tr>
						<td><code>feature</code></td>
						<td>
							for _, capability := range Capabilities {
								<code>{ capability }</code>{ " " }
							}
						</td>
						<td>
							Repeat or comma-separate; all must hold. A feature is returned only where a real call
							proved it. A model never probed for it is not returned.
						</td>
					</tr>
					<tr>
						<td><code>format</code></td>
						<td><code>env</code></td>
						<td>Plain text: <code>OPENAI_BASE_URL</code>, <code>OPENAI_API_KEY</code>, <code>OPENAI_MODEL</code>, taken from the top OpenAI-compatible row.</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p class="muted measure">
			An unknown value is a <code>400</code> that names the valid ones, not an empty list: an empty list
			would read as "everything is down". At most 50 models are returned per call. Replies are
			<code>Cache-Control: no-store</code> and CORS is open, so a browser can call it too.
			<code>GET /api/llm/&lt;endpoint&gt;</code> returns one provider with its models and recent probes.
		</p>
		<h2>What each model carries</h2>
		<div class="scroll">
			<table>
				<thead><tr><th>Field</th><th>Meaning</th></tr></thead>
				<tbody>
					<tr><td><code>model</code>, <code>endpoint</code></td><td>The model id to send, and the provider slug.</td></tr>
					<tr><td><code>openai_base_url</code></td><td>What to give an OpenAI client as its base URL. Not always the provider's bare host.</td></tr>
					<tr><td><code>auth</code></td><td><code>none</code> needs no Authorization header; <code>bearer</code> needs one of your own.</td></tr>
					<tr><td><code>answered</code>, <code>recent_attempts</code>, <code>recent_successes</code></td><td>How many of the last seven days' chat probes answered.</td></tr>
					<tr><td><code>last_ok</code>, <code>latency_ms</code></td><td>When it last answered, and how long that reply took.</td></tr>
					<tr><td><code>proved[]</code></td><td>Features a real call confirmed.</td></tr>
					<tr><td><code>claimed_unproved[]</code></td><td>Features the provider lists that we have not confirmed. Not a "no".</td></tr>
					<tr><td><code>failed[]</code></td><td>Features a call tried and did not get.</td></tr>
					<tr><td><code>capabilities</code></td><td>Each feature with the time it was checked and the error, where there was one.</td></tr>
				</tbody>
			</table>
		</div>
		<h2>A real row, as returned a moment ago</h2>
		<div class="snippet plain">
			<div class="pane" data-active>
				<pre><code>{ example }</code></pre>
			</div>
		</div>
		<h2>Errors and guarantees</h2>
		<p class="measure">
			An unknown <code>key</code> or <code>feature</code> answers <code>400</code>, with the valid values in the body.
			An unknown endpoint slug answers <code>404</code>. There is no guarantee: these are other people's free services,
			and an endpoint can add a key requirement or vanish between two probes. The payload says so in
			<code>disclaimer</code>, on every call.
		</p>
		<p>
			<a href="/free-llm-api-no-key">Free LLM APIs with no key</a> ·
			<a href="/">The shelf</a> ·
			<a href="/llms.txt">llms.txt</a>
		</p>
		@siteFooter()
	</div>
}

// trackRecordSection is the part of a provider page no list can have: counts
// from our own probe table, over a window the text names, including the
// refusals. It is prose and a day table, not a badge, because "99% uptime" with
// no window and no denominator is the claim this site exists to replace.
templ trackRecordSection(row ShelfRow, track TrackRecord) {
	<section class="track">
		<h2>{ "Track record: " + row.Provider }</h2>
		<p class="measure">{ track.Sentence() }</p>
		if track.Attempts > 0 {
			if sentence := track.RefusalSentence(); sentence != "" {
				<p class="muted measure">{ sentence }</p>
			}
			<p class="muted measure">
				{ fmt.Sprintf("Median reply %d ms, 95th percentile %d ms, over the calls that answered. ", track.MedianMS, track.P95MS) }
				if track.Since != nil {
					{ "We have been calling this endpoint since " + track.Since.UTC().Format("2 January 2006") + ". " }
				}
				if row.RequiresKey() {
					{ "Measured with our own free-tier key from this server's address: it says the endpoint answered our account, not what a new signup receives." }
				} else {
					{ "Measured with no Authorization header, from this server's address." }
				}
			</p>
			<div class="scroll">
				<table>
					<thead><tr><th>Day (UTC)</th><th>Chat calls</th><th>Answered</th><th>Median reply</th></tr></thead>
					<tbody>
						for _, day := range track.Days {
							<tr>
								<td class="when">{ day.Date.Format("2 Jan") }</td>
								<td>{ fmt.Sprint(day.Attempts) }</td>
								<td>
									if day.Attempts == 0 {
										{ "not probed" }
									} else {
										{ fmt.Sprintf("%d of %d", day.Answered, day.Attempts) }
									}
								</td>
								<td class="when">{ latency(day.MedianMS) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

// homeFAQ answers the four questions a visitor from search arrives with. It is
// ordinary visible text, written so that each answer is a link into the page
// that holds the evidence.
templ homeFAQ(total int) {
	<section class="faq">
		<div class="wrap">
			<h2>Free LLM API: questions this shelf answers</h2>
			<h3>Is there a free LLM API that needs no API key?</h3>
			<p>
				Yes, a handful, and they come and go. The ones answering right now are on
				<a href="/free-llm-api-no-key">the no-key page</a>, each called with no Authorization header
				and published with how often it answered.
			</p>
			<h3>How often is each endpoint checked?</h3>
			<p>
				Every endpoint gets real chat calls every hour. Feature checks (tool calling, JSON schema,
				vision, image output) run daily. The table above carries { countOf(total, "model") }, each with the time it was last verified.
			</p>
			<h3>Why can a listed endpoint still fail for me?</h3>
			<p>
				Quotas are usually per IP. One that answered this server can return <code>429</code> or
				<code>402</code> from yours, which is why the API returns a ranked list to walk.
			</p>
			<h3>How do I call one from code?</h3>
			<p>
				<code>GET /api/llm/up</code> returns the base URL, model id and auth for what is answering.
				Parameters and a Python, Node and curl loop are in <a href="/docs">the reference</a>. If you
				are choosing between lists, see <a href="/free-llm-api-resources-alternatives">how they compare</a>.
			</p>
		</div>
	</section>
}
