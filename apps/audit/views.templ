package audit

import (
	"fmt"
	"strings"
	"time"
)

// masthead is the same two lines on every page: the wordmark, and -- on the
// shelf, which is the only page with a sweep to report -- when the prober last
// got an answer out of anything.
//
// The wordmark and the clock share one row and the tagline gets its own
// full-width line below, so a longer sentence never shoves the clock onto a
// line of its own.
templ masthead(sweep *time.Time) {
	<header class="masthead">
		<div class="wrap">
			<div class="topline">
				<a class="mark" href="/"><span class="glyph"></span>stillworks</a>
				if sweep != nil {
					<span class="probe-clock">
						<span class="pulse"></span>{ "probing · last sweep " + humanWhen(*sweep) }
					</span>
				}
			</div>
			<p>
				<b class="shout">Dobby is freeeeeee</b>
				<span>
					— no key, no signup, no card. We don't read docs, we call the endpoint and publish
					what came back, including the 402s.
				</span>
			</p>
		</div>
	</header>
}

// siteFooter carries the pages that are not the shelf, plus the runtime API,
// which is the thing most likely to be wanted by whoever reads this far.
//
// A labelled nav rather than a <footer>. The framework owns the document body
// and puts every page inside <main>, and a <footer> nested in <main> is not a
// contentinfo landmark -- so these links, two of which are the only route left
// to their pages, would have been in no landmark at all.
templ siteFooter() {
	<nav class="site-foot muted" aria-label="Elsewhere on this site">
		<a href="/">the shelf</a>
		<a href="/mcp/">MCP servers (not open yet)</a>
		<a href="/stats">our own traffic</a>
		<a href="/api/llm/up"><code>GET /api/llm/up</code></a>
	</nav>
}

// copyable is a snippet with a button that puts it on the clipboard. The button
// is written hidden and revealed by the page's script, so with JavaScript off
// there is no button that does nothing -- just the text, selectable and wrapped
// rather than clipped, which is how it has to work anyway.
templ copyable(label string, text string) {
	<div class="snippet plain">
		<div class="pane" data-pane="curl" data-active>
			<pre><code>{ text }</code></pre>
		</div>
		<div class="snippet-foot">
			<button type="button" class="btn primary copy" data-copy-active hidden>{ "Copy " + label }</button>
		</div>
	</div>
}

// HomePage is the whole site: the two-step hero, the controls, one table
// holding both kinds of endpoint, and the footnotes that say what a row means.
//
// It replaced a home page, two shelves and a test-call page. The split cost a
// visitor the ability to see that a faster endpoint existed one page over, and
// cost the site a headline number that was true of anything.
templ HomePage(rows []WorkingModel, total int, query ShelfQuery, sweep *time.Time, origin string) {
	@masthead(sweep)
	@hero(origin)
	@controls(query, len(rows), total)
	@board(rows, query)
	@homeFooter()
}

// hero is the pitch, and the pitch is the API rather than any one model. A
// model named on this page is stale the moment a provider changes its mind; a
// call that asks what is answering right now is not.
templ hero(origin string) {
	<section class="lede">
		<div class="wrap">
			<div class="pitch">
				<p class="eyebrow">One call, then you are calling an LLM</p>
				<h1>
					Ask us what is answering right now. The reply carries everything the <em>next</em> call needs.
				</h1>
				<p class="sub">
					Base URL, model ID, whether a key is needed, what a real probe proved. Ranked, so
					<code>models[0]</code> is the pick and the rest are your fallbacks — which you will want,
					because keyless quotas are per-IP and the one that answered us can refuse you.
				</p>
			</div>
			// Both cards stretch to the row height. The left card decides that
			// height; the right card's pane has a flex-basis of 0 so a long
			// snippet scrolls inside it instead of making the row taller.
			<div class="steps">
				<div class="step">
					<div class="step-head"><span class="num">1</span> Ask what works</div>
					<div class="snippet">
						<div class="snippet-head">
							<span class="tab" aria-selected="true">GET /api/llm/up</span>
							<span class="who">no key, no signup, no rate limit</span>
						</div>
						<div class="stack">
							<div class="pane" data-pane="curl" data-active>
								<pre><code>{ "curl -s " + origin + "/api/llm/up" }</code></pre>
							</div>
						</div>
						<div class="returns">
							<span class="returns-label">every model carries</span>
							<code>model</code><code>openai_base_url</code><code>auth</code><code>latency_ms</code><code>answered</code><code>last_ok</code><code>proved[]</code><code>claimed_unproved[]</code><code>failed[]</code>
						</div>
						<div class="snippet-foot">
							<button type="button" class="btn primary copy" data-copy-active hidden>Copy</button>
							// Calls our own API from the visitor's browser and puts the
							// real answer in a toast. Hidden without JavaScript: the
							// line above is the instruction, and a button that does
							// nothing is worse than no button.
							<button type="button" class="btn" data-run-api={ origin + "/api/llm/up" } hidden>Run it here</button>
							<span class="note"><code>?feature=tools,vision</code> narrows it to what a real call proved</span>
						</div>
					</div>
				</div>
				<div class="step step-2">
					<div class="step-head"><span class="num">2</span> Call what came back</div>
					<div class="snippet">
						<div class="snippet-head" role="tablist" aria-label="Language">
							@paneTab("python", "python", true)
							@paneTab("js", "node", false)
							@paneTab("curl", "curl", false)
							<span class="who">nothing hardcoded but our URL</span>
						</div>
						<div class="stack">
							@pane("python", "python", true, fallbackLoop("python", origin))
							@pane("js", "node", false, fallbackLoop("js", origin))
							@pane("curl", "curl", false, fallbackLoop("curl", origin))
						</div>
						<div class="snippet-foot">
							<button type="button" class="btn primary copy" data-copy-active hidden>Copy</button>
							<span class="note">Walk the list until one answers. That loop is the whole point of the shelf.</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

// paneTab and pane are the two halves of a language switcher. The tabs are
// written hidden and revealed by the script; without it every pane is shown
// stacked under its own label, so nothing is unreachable and no control is
// inert. With the script the panes share one grid cell, which is why switching
// languages moves nothing else on the page.
templ paneTab(name string, label string, selected bool) {
	<button type="button" class="tab" role="tab" data-fmt={ name } aria-selected={ boolAttr(selected) } hidden>
		{ label }
	</button>
}

templ pane(name string, label string, active bool, code string) {
	<div class="pane" data-pane={ name } data-active?={ active }>
		<span class="pane-label">{ label }</span>
		<pre><code>{ code }</code></pre>
	</div>
}

// controls is the filter bar. Every control is a link or a GET form, so the
// whole thing works with JavaScript switched off and every state it can reach
// is an address somebody can send to somebody else.
templ controls(query ShelfQuery, shown int, total int) {
	<div class="controls">
		<div class="wrap">
			// A real form with a real submit button, because filtering happens on
			// the server. The hidden fields carry the rest of the state: a form
			// posts only its own inputs, and losing the key filter every time you
			// searched would be one control quietly undoing another.
			<form class="field-form" method="get" action="/">
				<label class="field">
					<span class="sr">Search model or provider</span>
					<span class="icon">/</span>
					<input id="q" type="search" name="q" value={ query.Search } placeholder="model or provider…" autocomplete="off"/>
				</label>
				if query.Key != "" && query.Key != AuthModeAny {
					<input type="hidden" name="key" value={ query.Key }/>
				}
				for _, capability := range query.Features {
					<input type="hidden" name="feature" value={ capability }/>
				}
				<button type="submit" class="chip go">Search</button>
			</form>
			<div class="group" role="group" aria-label="Key requirement">
				<span class="glabel">Key</span>
				@chip(query.KeyLink(AuthModeAny), "Any", query.KeyChoice() == AuthModeAny)
				@chip(query.KeyLink(AuthModeNone), "Not needed", query.KeyChoice() == AuthModeNone)
				@chip(query.KeyLink(AuthModeKey), "Required", query.KeyChoice() == AuthModeKey)
			</div>
			<div class="group" role="group" aria-label="Must have, proved by a real call">
				<span class="glabel">Proved</span>
				for _, capability := range ChatCapabilities {
					@chip(query.FeatureLink(capability), capabilityLabel(capability), query.HasFeature(capability))
				}
			</div>
			<span class="count">
				<b>{ fmt.Sprint(shown) }</b>{ fmt.Sprintf(" of %d models", total) }
				if len(query.Features) > 0 {
					{ " · proved " + strings.Join(capabilityLabels(query.Features), " + ") }
				}
			</span>
		</div>
	</div>
}

// chip is one filter control. A link rather than a button: the filtered shelf
// has an address, so it can be bookmarked, shared, and used by something with
// no JavaScript at all. aria-current rather than aria-pressed, which belongs to
// a button and would be a lie on an anchor.
templ chip(href string, label string, active bool) {
	<a class="chip" href={ templ.SafeURL(href) } aria-current={ boolAttr(active) }>{ label }</a>
}

// board is the table: both kinds of endpoint, one row each, labelled.
templ board(rows []WorkingModel, query ShelfQuery) {
	<section class="board">
		<div class="wrap">
			<p class="caption">
				{ orderingSentence(query) } None of it is a promise about the next minute — that is what the
				timestamps are for. Click any row for its snippet.
			</p>
			if len(query.UnknownFeatures) > 0 {
				// A filter a visitor typed that we publish no verdict for. Said out
				// loud rather than dropped: a filter that quietly does nothing is
				// worse than one that refuses, because the table underneath it then
				// reads as an answer to a question nobody asked.
				<p class="warn measure">{ unknownFeatureWarning(query.UnknownFeatures) }</p>
			}
			<div class="legend">
				<span class="item"><span class="dot yes"></span> we called it and it worked</span>
				<span class="item"><span class="dot no"></span> we called it and it failed</span>
				<span class="item"><span class="dot claimed"></span> provider claims it, our call never proved it</span>
				<span class="item"><span class="dot unknown"></span> never probed</span>
			</div>
			<div class="scroll">
				<table>
					<thead>
						<tr>
							<th class="caret-col" scope="col"><span class="sr">Expand</span></th>
							@sortableHeader(query, "model", "Model", false)
							<th scope="col">Key</th>
							<th class="cap" scope="col" title="The model called a function we offered, and we could dispatch it">Tools</th>
							<th class="cap" scope="col" title="The reply parsed as JSON and matched a schema we sent">Schema</th>
							<th class="cap" scope="col" title="The reply parsed as JSON in the provider's JSON mode">JSON</th>
							<th class="cap" scope="col" title="It answered a question about an image we sent">Vision</th>
							@sortableHeader(query, "latency", "Latency", true)
							@sortableHeader(query, "reliability", "Answered", false)
							@sortableHeader(query, "verified", "Verified", true)
							<th scope="col"><span class="sr">Copy</span></th>
						</tr>
					</thead>
					<tbody>
						for _, model := range rows {
							@row(model, query)
						}
					</tbody>
				</table>
			</div>
			if len(rows) == 0 {
				<div class="empty">
					if query.Filtered() {
						<b>Nothing on the shelf matches that filter.</b>
						<br/>
						Unprobed models are hidden by a capability filter — that is not the same as failing it.
						<br/>
						<a href="/">Show every row.</a>
					} else {
						<b>Nothing on this shelf is currently verified.</b>
						<br/>
						That is a real answer, not a loading state.
					}
				</div>
			}
		</div>
	</section>
}

// sortableHeader makes a column heading a link that sorts by it. A link rather
// than a button, for the same reason the chips are links.
//
// The arrow is rendered on every sortable column, active or not, and dimmed by
// the stylesheet. One that appeared only on the sorted column would change that
// heading's width the moment it was clicked, and every column to its right
// would move.
templ sortableHeader(query ShelfQuery, key string, label string, numeric bool) {
	<th
		class={ "sortable", templ.KV("num", numeric) }
		scope="col"
		aria-sort={ query.SortDirection(key) }
	>
		<a class="sort" href={ templ.SafeURL(query.WorkingSortLink(key)) }>
			{ label }<span class="arrow">{ query.SortArrow(key) }</span>
		</a>
	</th>
}

// row is one model, plus its drawer.
//
// Every drawer is rendered, and all but the open one carry the hidden
// attribute. That is what lets the caret be a plain link: with no JavaScript it
// is a round trip that opens the row on the server, and with JavaScript the
// script toggles the attribute and rewrites the address instead. The
// alternative -- building the drawer in the browser -- would have meant a
// second implementation of every snippet on this site, which is exactly how the
// endpoint pages ended up printing a base URL that answers 404.
templ row(model WorkingModel, query ShelfQuery) {
	{{ identifier := RowID(model.Slug, model.ModelID) }}
	{{ open := query.IsOpen(model.Slug, model.ModelID) }}
	<tr class={ "row", templ.KV("open", open) } data-row={ identifier }>
		<td class="caret-cell">
			<a
				class="caret"
				href={ templ.SafeURL(query.OpenLink(model.Slug, model.ModelID)) }
				aria-expanded={ boolAttr(open) }
				aria-label={ "Details for " + model.ModelID }
			>›</a>
		</td>
		<td>
			<span class="model">{ model.ModelID }</span>
			<span class="provider">
				<a href={ templ.SafeURL("/llm/" + model.Slug) }>{ model.Slug }</a>
				{ " · " + hostOf(model.OpenAIBaseURL()) }
			</span>
		</td>
		<td>
			if model.RequiresKey() {
				<span class="authchip key">key</span>
			} else {
				<span class="authchip none">not needed</span>
			}
		</td>
		for _, capability := range ChatCapabilities {
			@capabilityDot(model.Capabilities, capability)
		}
		<td class="num">{ latency(model.LatencyMS) }</td>
		<td>
			<span class="bar">
				<span class="track">
					// The width is a class rather than a style attribute: the
					// Content-Security-Policy is default-src 'self', which drops an
					// inline style silently, so the bar would have rendered empty in
					// production and full in local development. The classes step in
					// fives; the exact fraction is printed beside it, and that is the
					// number anybody is actually reading.
					<span class={ "fill", barWidthClass(model.Successes, model.Attempts), templ.KV("warn", model.Successes < model.Attempts) }></span>
				</span>
				<span>{ reliability(model.Successes, model.Attempts) }</span>
			</span>
		</td>
		<td class="num">{ humanWhenPtr(model.LastOK) }</td>
		<td class="act">
			<button type="button" class="btn copy" data-copy-row={ identifier } hidden>Copy curl</button>
		</td>
	</tr>
	<tr class="detail" data-row-detail={ identifier } hidden?={ !open }>
		<td colspan="11">
			@drawer(model)
		</td>
	</tr>
}

// drawer is the expanded row: the call in four shapes, and the facts behind the
// verdict.
templ drawer(model WorkingModel) {
	<div class="drawer">
		<div class="snippet">
			<div class="snippet-head" role="tablist" aria-label="Language">
				@paneTab("curl", "curl", true)
				if model.OpenAICompatible {
					@paneTab("env", ".env", false)
					@paneTab("python", "python", false)
					@paneTab("js", "node", false)
				}
			</div>
			<div class="stack">
				@pane("curl", "curl", true, snippet(model))
				// Only for an endpoint that speaks the OpenAI shape. An
				// Ollama-flavoured one has no OPENAI_BASE_URL to give and no OpenAI
				// client to give it to, and printing them anyway is a paste that
				// fails on first use -- the exact defect this site exists to name in
				// other people's directories.
				if model.OpenAICompatible {
					@pane("env", ".env", false, EnvLines(model))
					@pane("python", "python", false, pythonSnippet(model))
					@pane("js", "node", false, nodeSnippet(model))
				}
			</div>
			<div class="snippet-foot">
				<button type="button" class="btn primary copy" data-copy-active hidden>Copy</button>
				if model.RequiresKey() {
					<span class="note">The key line is a placeholder. Ours never leaves the deployment's environment.</span>
				} else if !model.OpenAICompatible {
					<span class="note">Ollama-shaped, not OpenAI — no <code>OPENAI_BASE_URL</code> describes it.</span>
				}
			</div>
		</div>
		<div class="facts">
			<dl>
				if model.OpenAICompatible {
					<dt>Base URL</dt>
					<dd>{ model.OpenAIBaseURL() }</dd>
				} else {
					<dt>Call URL</dt>
					<dd>{ directCallURL(model) }</dd>
				}
				<dt>Model ID</dt>
				<dd>{ model.ModelID }</dd>
				<dt>Auth</dt>
				if model.RequiresKey() {
					<dd>our own free-tier key</dd>
				} else {
					<dd>none — no Authorization header sent</dd>
				}
				<dt>Answered</dt>
				<dd>{ reliabilitySentence(model.Successes, model.Attempts) }</dd>
				<dt>Last ok</dt>
				<dd>{ humanWhenPtr(model.LastOK) }</dd>
			</dl>
			<div class="tryout">
				if model.RequiresKey() {
					// No button, and the sentence says why. A test from here would
					// need either the reader's key -- which we will not ask for and
					// have nowhere safe to put -- or ours, which would be free
					// inference handed out on our quota, proving nothing the row does
					// not already say.
					<span class="note">
						A test from here would need your key, and we will not ask for it. Paste the snippet where
						your key already lives.
					</span>
				} else {
					// Hidden without JavaScript. The call is made by the visitor's own
					// browser, because keyless quotas are per-IP and a call from our
					// server answers a question nobody asked.
					<button
						type="button"
						class="btn"
						data-try={ directCallURL(model) }
						data-shape={ callShape(model) }
						data-model={ model.ModelID }
						data-endpoint={ model.Slug }
						hidden
					>Send a test call from your browser</button>
				}
			</div>
		</div>
	</div>
}

// homeFooter is the three things a row cannot say for itself: what it means,
// what it cannot tell you, and that the table is the API.
templ homeFooter() {
	<footer class="foot">
		<div class="wrap">
			<div>
				<h3>What a row means</h3>
				<p>
					We send a real chat completion to the endpoint on a schedule and publish what came back —
					latency, how many of the recent checks answered, and when the last one did.
				</p>
				<p>
					Keyless rows carried <b>no Authorization header at all</b>. Rows marked <b>key</b> carried
					<b>our own</b> free-tier key, which proves the endpoint answered our account — not what your
					signup gets.
				</p>
			</div>
			<div>
				<h3>What we cannot tell you</h3>
				<p>
					Keyless quotas are usually per-IP. An endpoint verified from this server can still answer
					<code>402</code> or <code>429</code> from yours.
				</p>
				<p>
					These are other people's free services. Any of them can add a key requirement or disappear
					between two probes.
				</p>
			</div>
			<div>
				<h3>The table is this API</h3>
				<p>
					Every filter here is a query parameter there: <code>?feature=tools,vision</code>,
					<code>?key=none</code>, <code>?q=qwen</code>. Same ranking, same rows.
				</p>
				<p>Filters live in the URL, so a filtered shelf is a link you can send someone.</p>
				@capabilityLegend()
				@siteFooter()
			</div>
		</div>
	</footer>
}

// capabilityDot is one feature verdict as a dot. A capability nobody has asked
// about renders as an empty dashed ring and never as a failure: the whole
// tri-state exists so that "we have not checked" and "it does not work" stay
// different answers, and the screen-reader text says which one this is.
templ capabilityDot(records map[string]CapabilityRecord, capability string) {
	{{ state := capabilityState(records, capability) }}
	<td class="cap">
		<span class={ "dot", state } title={ capabilityStateTitle(state) }></span>
		<span class="sr">{ capabilityLabel(capability) + ": " + capabilityStateTitle(state) }</span>
	</td>
}

// endpointCall is the callable half of an endpoint's page: the base URL an
// OpenAI client can be handed, and a call that runs exactly as printed.
//
// The model it names is the first one on the page's own ordering that this
// endpoint has actually verified, so the snippet is never built from a model
// the endpoint refuses. When there is none it says so rather than printing a
// call that cannot work.
templ endpointCall(row ShelfRow, models []ModelRow) {
	<section class="start">
		<h2 class="start-h">Call it</h2>
		<dl class="start-facts">
			if row.OpenAICompatible {
				<dt>Base URL</dt>
				<dd><code>{ row.OpenAIBaseURL() }</code></dd>
			} else {
				// An Ollama-shaped endpoint has no OPENAI_BASE_URL to give.
				// Printing one would be a paste that fails on first use.
				<dt>Call URL</dt>
				<dd><code>{ row.CallURL() }</code></dd>
				<dt>Shape</dt>
				<dd>Ollama, not OpenAI — no <code>OPENAI_BASE_URL</code> describes it.</dd>
			}
			<dt>API key</dt>
			if row.RequiresKey() {
				<dd>your own from { row.Provider }</dd>
			} else {
				<dd>none — send no <code>Authorization</code> header at all</dd>
			}
		</dl>
		if verified, found := firstVerifiedModel(row, models); found {
			@copyable("as curl", endpointSnippet(row, verified))
			if row.OpenAICompatible {
				@copyable("as .env", endpointEnvLines(row, verified))
			}
			// LastOK, not LastChecked. A probe writes last_checked every time and
			// last_ok only when the call succeeded, so a model that has been
			// rate-limited for hours has a last_checked of minutes ago -- and
			// printing that after the word "answered" invents an answer.
			<p class="muted small measure">
				Using <code>{ verified.ModelID }</code>, { reliabilitySentence(verified.Successes, verified.Attempts) },
				last { answeredHowPast(row.RequiresKey()) } { humanWhenPtr(verified.LastOK) } from this
				server's address. Every model this endpoint offers is in the table below.
			</p>
		} else {
			<p class="warn measure">
				{ "No model on this endpoint is currently verified " + answeredHow(row.AuthMode) + ", so there is no call here we would stand behind. " }
				The raw probe log at the bottom of this page says what happened instead.
			</p>
		}
	</section>
}

templ EndpointPage(row ShelfRow, models []ModelRow, probes []ProbeRow) {
	@masthead(nil)
	<div class="sw">
		<h1>{ row.Slug }</h1>
		<p class="tag">
			{ row.Provider }
			if row.DocsURL != "" {
				— <a href={ templ.SafeURL(row.DocsURL) } rel="nofollow noopener">docs</a>
			}
		</p>
		// The callable values, first, on a page that previously had no <pre>
		// block and no button anywhere on it -- and printed the bare host as the
		// base URL, which for this provider answers 404 to every call.
		@endpointCall(row, models)
		if row.RequiresKey() {
			<p class="warn">
				This provider requires an API key. Every row below was measured with stillworks' own
				free-tier key, from this server's address, at the time shown. That says the endpoint
				answered <em>our</em> account — it says nothing about what a new signup's free tier
				includes, and we have no way to measure that for you. Our key is never shown here,
				returned by the API, or stored in the database.
			</p>
		}
		if row.Notes != "" {
			<p class="lede muted">{ row.Notes }</p>
		}
		<h2>Models</h2>
		// This is the page a phone visitor is sent to when the shelf folds its
		// feature columns away, so the feature columns are the ones that stay.
		// Four others carry no weight on a 390px screen -- the tier the provider
		// named, whether it chats, the week's fraction, and the time the listing
		// last mentioned it -- and they fold instead.
		<div class="scroll">
			<table>
				<thead>
					<tr>
						<th>Model</th><th>Tier</th>
						if row.RequiresKey() {
							<th>Answers our key</th>
						} else {
							<th>Keyless</th>
						}
						<th class="detail">Chat</th>
						<th>Tools</th><th>Schema</th><th>JSON</th><th>Vision</th><th>Draws</th>
						<th class="detail">Worked</th><th>Last checked</th><th class="detail">Last listed</th>
					</tr>
				</thead>
				<tbody>
					for _, model := range models {
						<tr>
							<td><code>{ model.ModelID }</code></td>
							<td class="muted">{ orDash(model.Tier) }</td>
							<td>{ verdictLabel(model.Verdict(row.RequiresKey()), row.RequiresKey()) }</td>
							<td class="muted detail">
								if model.ChatCapable {
									yes
								} else {
									not a chat model
								}
							</td>
							for _, capability := range Capabilities {
								@capabilityCell(model.Capabilities, capability)
							}
							<td class="when detail">{ reliability(model.Successes, model.Attempts) }</td>
							<td class="when">{ humanWhenPtr(model.LastChecked) }</td>
							<td class="when detail">{ humanWhen(model.LastSeen) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		// Unconditional, unlike the shelf's. This table is wider than the page at
		// every width the site is rendered at, so saying it only below 760px
		// would disclose folding on a phone and say nothing on a desktop where
		// the columns are equally invisible.
		<p class="muted small scroll-note">
			Scroll the table sideways for the rest of each row.
			<span class="narrow-only">Chat, Worked and Last listed are folded away at this width.</span>
		</p>
		<p class="muted measure">
			Feature columns are measurements. Where the provider's own listing claims a
			feature we could not get out of it, the cell says so — that disagreement is the
			reason this shelf exists.
		</p>
		@capabilityLegend()
		<h2>Raw probe log</h2>
		<p class="muted measure">
			Our working, so you can check it rather than trust it. Wider than the page at any width —
			scroll it sideways for the Detail column, which quotes the provider's own refusal back.
		</p>
		<div class="scroll">
			<table>
				<thead>
					<tr><th>When</th><th>Kind</th><th>Outcome</th><th>HTTP</th><th>Latency</th><th>Model</th><th>Detail</th></tr>
				</thead>
				<tbody>
					for _, probe := range probes {
						<tr>
							<td class="when">{ humanWhen(probe.StartedAt) }</td>
							<td>{ probe.Kind }</td>
							<td><span class={ outcomeClass(probe.Outcome) }>{ probe.Outcome }</span></td>
							<td>{ statusLabel(probe.HTTPStatus) }</td>
							<td class="when">{ latency(probe.LatencyMS) }</td>
							<td><code>{ orDash(probe.ModelUsed) }</code></td>
							<td class="muted">{ truncate(probe.Error, 90) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@siteFooter()
	</div>
}

// capabilityLegend is the answer to "what does Schema mean". It is a <details>
// and not a tooltip: a title attribute does not exist on a phone, and the phone
// is where the columns are folded away in the first place.
//
// Everything in it is a statement about what a call did, because that is the
// only thing this site knows.
templ capabilityLegend() {
	<details class="legend-panel" id="what-the-columns-mean">
		<summary>
			What <strong>Tools</strong>, <strong>Schema</strong>, <strong>JSON</strong> and
			<strong>Vision</strong> mean, and what each cell state means
		</summary>
		<div class="legend-body">
			<h3>The columns</h3>
			<dl>
				<dt>Tools</dt>
				<dd>
					We sent a <code>tools</code> array and the model came back with a well-formed
					<code>tool_calls</code> entry an agent could dispatch. A 200 with no tool call in it
					is not tool support, and is recorded as a no.
				</dd>
				<dt>Schema</dt>
				<dd>
					The strict structured-output mode:
					<code>response_format: {"{"}"type": "json_schema", …{"}"}</code>. The reply parsed and
					matched the schema we sent.
				</dd>
				<dt>JSON</dt>
				<dd>
					The weaker mode: <code>response_format: {"{"}"type": "json_object"{"}"}</code>. Valid
					JSON, with no shape enforced. The two come apart in both directions — OVH's
					<code>Mistral-7B-Instruct-v0.3</code> does the strict form and emits invalid JSON for
					the weak one; llm7's <code>meta-Llama-3.1-8B-Instruct-Turbo</code> does
					<code>json_object</code> while <code>json_schema</code> answers 405.
				</dd>
				<dt>Vision</dt>
				<dd>
					A real image went in inline and a correct answer about it came back. We ask about
					something only a model that looked could know.
				</dd>
				<dt>Draws</dt>
				<dd>
					On an endpoint's own page: bytes came back with an image content type, and they
					really are an image. Not a 200 taken on trust.
				</dd>
			</dl>
			<h3>The cell states</h3>
			<dl>
				<dt class="ok">yes</dt>
				<dd>A real call proved it. Hover the dot, or read the endpoint page, for when.</dd>
				<dt class="bad">no</dt>
				<dd>A clean negative: the parameter was refused, or the answer did not conform.</dd>
				<dt class="bad">no, claimed</dt>
				<dd>
					The negative contradicts the provider's own published claim — their listing
					advertises the feature and our call could not get it out of the model. This is the
					most interesting cell on the site and the reason the shelf exists.
				</dd>
				<dt class="muted">never probed</dt>
				<dd>
					No verdict. Either nobody has asked yet, or the check ran and got no usable answer
					back — Pollinations sits here because its anonymous pool answered 402 to every
					feature probe. It is a question, never a no.
				</dd>
			</dl>
		</div>
	</details>
}

templ StatsPage(report TrafficReport, dropped int64) {
	@masthead(nil)
	<div class="sw">
		<h1>Our own numbers</h1>
		<p class="tag">
			This site's whole claim is that a directory should publish what it measured and when.
			That standard applies to its own traffic too.
		</p>
		<div class="stats">
			<div class="stat">
				<span class="stat-n">{ fmt.Sprint(report.Totals.APICalls) }</span>
				<span class="stat-l">runtime API calls</span>
			</div>
			<div class="stat">
				<span class="stat-n">{ fmt.Sprint(report.Totals.Sessions) }</span>
				<span class="stat-l">visitors</span>
			</div>
			<div class="stat">
				<span class="stat-n">{ fmt.Sprint(report.Totals.PageViews) }</span>
				<span class="stat-l">page views</span>
			</div>
			<div class="stat">
				<span class="stat-n">{ fmt.Sprint(report.Totals.APIClients) }</span>
				<span class="stat-l">distinct API clients</span>
			</div>
		</div>
		<p class="muted">
			All-time, since { humanWhenPtr(report.Totals.FirstAt) }.
			if report.Totals.CrawlerHits > 0 {
				{ fmt.Sprintf("%d crawler hit(s) recorded and excluded from every count above.", report.Totals.CrawlerHits) }
			}
			if report.Totals.InternalHits > 0 {
				{ fmt.Sprintf("%d request(s) from our own deploy checks and tests, also excluded.", report.Totals.InternalHits) }
			}
		</p>
		<h2>{ fmt.Sprintf("Last %d days", statsDays) }</h2>
		if len(report.Days) == 0 {
			<p class="muted">Nothing recorded yet. That is a real answer, not a loading state.</p>
		} else {
			<div class="scroll">
				<table>
					<thead>
						<tr><th>Day (UTC)</th><th>Visitors</th><th>Page views</th><th>API calls</th></tr>
					</thead>
					<tbody>
						for _, day := range report.Days {
							<tr>
								<td class="when">{ day.Day.Format("2006-01-02") }</td>
								<td>{ fmt.Sprint(day.Sessions) }</td>
								<td>{ fmt.Sprint(day.PageViews) }</td>
								<td>{ fmt.Sprint(day.APICalls) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h2>Where visitors came from</h2>
		if len(report.Referrers) == 0 {
			<p class="muted">No referring host has sent anybody yet.</p>
		} else {
			<div class="scroll">
				<table>
					<thead>
						<tr><th>Referring host</th><th>Hits</th><th>Visitors</th></tr>
					</thead>
					<tbody>
						for _, referrer := range report.Referrers {
							<tr>
								<td>{ referrer.Host }</td>
								<td>{ fmt.Sprint(referrer.Hits) }</td>
								<td>{ fmt.Sprint(referrer.Visitors) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h2>What was asked for</h2>
		if len(report.Paths) == 0 {
			<p class="muted">Nothing yet.</p>
		} else {
			<div class="scroll">
				<table>
					<thead>
						<tr><th>Path</th><th>Kind</th><th>Hits</th></tr>
					</thead>
					<tbody>
						for _, path := range report.Paths {
							<tr>
								<td><code>{ path.Path }</code></td>
								<td class="muted">{ path.Kind }</td>
								<td>{ fmt.Sprint(path.Hits) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h2>How this is counted</h2>
		<ul class="muted">
			<li>
				A visitor is one salted hash of address and user agent, on one UTC day. The hash
				input includes the date, so it cannot be followed from one day to the next, and
				the address itself is never written down.
			</li>
			<li>Requests to this page and to <code>/api/stats</code> are never counted. Reading the scoreboard must not move it.</li>
			<li>Crawlers are recorded and excluded. Deleting them would hide a traffic source; counting them would turn a search engine into an audience.</li>
			<li>
				Our own requests are recorded and excluded too — deploy checks, browser tests, the
				machine this is built on. These numbers decide whether the project continues, and
				counting our own work as demand is the most comfortable way to get that decision
				wrong.
			</li>
			<li>Counts are written from a bounded in-memory buffer, so a restart can lose up to two seconds of events.</li>
			if dropped > 0 {
				<li class="warn">{ fmt.Sprintf("%d event(s) were dropped because the write buffer was full. Under-counting is reported, never hidden.", dropped) }</li>
			}
		</ul>
		<p class="muted">Same numbers as JSON: <code>curl https://stillworks.supercapybara.com/api/stats</code></p>
		@siteFooter()
	</div>
}

// capabilityCell renders one feature verdict as a word, for the endpoint page's
// wide matrix. A capability nobody has asked about renders as a dash and never
// as a "no": the whole tri-state exists so that "we have not checked" and "it
// does not work" stay different answers.
templ capabilityCell(records map[string]CapabilityRecord, capability string) {
	if record, held := records[capability]; !held || record.Supported == nil {
		// A dash covers two facts and the tooltip says which one this is.
		// Rendering both as "never verified" was wrong for every row where the
		// check ran and the provider rate-limited it: checked_at was set,
		// supported was still null, and the page claimed nobody had asked.
		<td class="muted feature" title={ dashReason(record, held) }>—</td>
	} else if *record.Supported {
		<td class="ok feature" title={ "verified " + humanWhenPtr(record.LastOK) }>yes</td>
	} else if record.ClaimContradicted() {
		<td class="bad feature" title={ truncate(record.LastError, 160) }>no, claimed</td>
	} else {
		<td class="bad feature" title={ truncate(record.LastError, 160) }>no</td>
	}
}

templ NotFoundPage(what string) {
	@masthead(nil)
	<div class="sw">
		<h1>Not here</h1>
		<p class="muted measure">{ what }</p>
		<p><a href="/">Every endpoint we track</a></p>
		@siteFooter()
	</div>
}

templ ComingSoonPage() {
	@masthead(nil)
	<div class="sw">
		<h1>MCP servers</h1>
		<p class="lede">
			Twenty thousand servers are listed across the registries and you cannot know what any
			of them exposes without running it. That shelf will record what each one actually
			does: whether it starts, which tools it registers, and which secrets it demands.
		</p>
		<p class="muted measure">Not open yet. The LLM shelf ships first and has to earn its keep.</p>
		<p><a href="/">The LLM shelf is here</a></p>
		@siteFooter()
	</div>
}

// boolAttr renders an attribute whose value is the word true or false rather
// than the attribute's presence. aria-current, aria-expanded and aria-selected
// all need the word: an absent aria-expanded means "this does not expand", not
// "it is closed".
func boolAttr(value bool) string {
	if value {
		return "true"
	}
	return "false"
}

// hostOf is the base URL with its scheme taken off, for the line under a model
// id where the whole URL would set the column's width.
func hostOf(baseURL string) string {
	trimmed := strings.TrimPrefix(baseURL, "https://")
	return strings.TrimPrefix(trimmed, "http://")
}

// capabilityState collapses one feature record into the five states the dot can
// draw. It is a string rather than a set of booleans because the class name, the
// tooltip and the screen-reader text all have to agree, and three switch
// statements over the same record are three chances for them not to.
func capabilityState(records map[string]CapabilityRecord, capability string) string {
	record, held := records[capability]
	switch {
	case !held || record.Supported == nil:
		// Claimed but never proved is its own state, and a common one on this
		// shelf: a provider's listing is free to say anything, and until a call
		// gets the feature out of the model we have measured nothing.
		if held && record.Claimed != nil && *record.Claimed {
			return "claimed"
		}
		return "unknown"
	case *record.Supported:
		return "yes"
	case record.ClaimContradicted():
		return "claimed-no"
	default:
		return "no"
	}
}

func capabilityStateTitle(state string) string {
	switch state {
	case "yes":
		return "we called it and it worked"
	case "no":
		return "we called it and it failed"
	case "claimed-no":
		return "the provider claims it, our call failed"
	case "claimed":
		return "the provider claims it, our call never proved it"
	default:
		return "never probed"
	}
}

// barWidthClass is the track fill, in steps of five percent.
//
// It is a class and not a width because the Content-Security-Policy is
// default-src 'self': an inline style attribute is dropped by the browser with
// no error anywhere, so every bar would have been empty in production and
// correct in local development. The fraction printed beside the bar is exact.
func barWidthClass(successes, attempts int) string {
	if attempts <= 0 {
		return "w0"
	}
	steps := (successes*20 + attempts/2) / attempts
	if steps > 20 {
		steps = 20
	}
	if steps < 0 {
		steps = 0
	}
	return fmt.Sprintf("w%d", steps*5)
}

func outcomeClass(outcome string) string {
	switch outcome {
	case OutcomeOK:
		return "ok"
	case OutcomeNeedsKey, OutcomeBlocked, OutcomeUnreachable, OutcomeServerError, OutcomeBadBody:
		return "bad"
	case OutcomeRateLimited, OutcomeTimeout, OutcomeClientError:
		return "warn"
	default:
		return "muted"
	}
}

// verdictLabel words the same tri-state for both kinds of endpoint. The words
// differ because the fact differs: "yes" on a keyless endpoint means anybody can
// call it, and on a keyed one it means our key was accepted.
func verdictLabel(verdict *bool, requiresKey bool) string {
	switch {
	case verdict == nil:
		return "not yet checked"
	case *verdict && requiresKey:
		return "yes, on our key"
	case *verdict:
		return "yes"
	case requiresKey:
		return "refused our key"
	default:
		return "needs a key"
	}
}

// answeredHow is the phrase that finishes "verified …". It exists so no page can
// end up saying "verified keyless" about a row that was measured with a
// credential.
func answeredHow(auth string) string {
	if auth == AuthModeKey {
		return "on our key"
	}
	return "keyless"
}

// capabilityLabel is the column heading for a capability. The names in the
// database are the API's, which are the OpenAI request fields they test; the
// headings are short enough to sit above a column of dots.
func capabilityLabel(capability string) string {
	switch capability {
	case CapabilityTools:
		return "Tools"
	case CapabilityJSONSchema:
		return "Schema"
	case CapabilityJSONObject:
		return "JSON"
	case CapabilityVision:
		return "Vision"
	case CapabilityImageOut:
		return "Draws"
	default:
		return capability
	}
}

// countOf pluralises. "17 model(s)" is a programmer writing to a compiler in
// public, on the sentence that carries the site's headline number.
func countOf(count int, noun string) string {
	if count == 1 {
		return fmt.Sprintf("1 %s", noun)
	}
	return fmt.Sprintf("%d %ss", count, noun)
}

// humanList joins names the way a sentence does, so a warning about an unknown
// filter reads as English rather than as a slice printed by mistake.
func humanList(values []string) string {
	switch len(values) {
	case 0:
		return ""
	case 1:
		return values[0]
	case 2:
		return values[0] + " and " + values[1]
	default:
		return strings.Join(values[:len(values)-1], ", ") + " and " + values[len(values)-1]
	}
}

// reliabilitySentence says what a fraction means, for the places that have room
// for a sentence. The column keeps the fraction.
func reliabilitySentence(successes, attempts int) string {
	if attempts == 0 {
		return "not probed in the last week"
	}
	if successes == attempts {
		return fmt.Sprintf("answered all %s we made in the last week", countOf(attempts, "check"))
	}
	return fmt.Sprintf("answered %d of the %s we made in the last week", successes, countOf(attempts, "check"))
}

// unknownFeatureWarning is built as one string rather than three template
// expressions, because templ renders the newline between two expressions as a
// space and the sentence would arrive with a double space in the middle of it.
//
// image_out gets its own sentence rather than being folded into the
// no-verdict-published one. We do publish an image_out verdict -- it is the
// Draws column on every endpoint page and the API accepts it as a filter. It is
// refused here only because this table holds models that chat, so filtering it
// by a drawing capability could only ever empty it.
func unknownFeatureWarning(unknown []string) string {
	named := make([]string, 0, len(unknown))
	drawing := false
	for _, feature := range unknown {
		if feature == CapabilityImageOut {
			drawing = true
			continue
		}
		named = append(named, feature)
	}
	var message string
	if len(named) > 0 {
		message = "No verdict is published for " + humanList(named) +
			", so that part of the filter was not applied. The features this shelf measures are " +
			humanList(ChatCapabilities) + "."
	}
	if drawing {
		if message != "" {
			message += " "
		}
		message += "This table holds models that chat, so it cannot be filtered by " + CapabilityImageOut +
			" — no model both draws and chats. What we measured about drawing is the Draws column on " +
			"each endpoint's own page."
	}
	return message
}

// orderingSentence says how the table below is actually ordered. Every column
// heading is a sort link, so the sentence has to follow the sort rather than
// state the default and be wrong on every other view.
func orderingSentence(query ShelfQuery) string {
	direction := func(descending, ascending string) string {
		if query.WorkingOrder == orderDescending {
			return descending
		}
		return ascending
	}
	switch query.WorkingSort {
	case "best":
		return "No key needed first, then by how much of the last week each one answered, then by speed."
	case "reliability":
		return direction("Most reliable first.", "Least reliable first.")
	case "verified":
		return direction("Most recently verified first.", "Least recently verified first.")
	case "latency":
		return direction("Slowest first.", "Fastest first.")
	case "model":
		return direction("By model name, Z to A.", "By model name, A to Z.")
	case "endpoint":
		return direction("Grouped by endpoint, Z to A.", "Grouped by endpoint, A to Z.")
	case CapabilityTools, CapabilityJSONSchema, CapabilityJSONObject, CapabilityVision:
		label := strings.ToLower(capabilityLabel(query.WorkingSort))
		return direction(
			"Models proved to do "+label+" first.",
			"Models proved to do "+label+" last.")
	default:
		return "Ordered by " + query.WorkingSort + "."
	}
}

func capabilityLabels(capabilities []string) []string {
	labels := make([]string, 0, len(capabilities))
	for _, capability := range capabilities {
		labels = append(labels, strings.ToLower(capabilityLabel(capability)))
	}
	return labels
}

// answeredHowPast is "answered" or "answered our key", for a sentence about a
// past call. Same rule as answeredHow: no page may say a call was keyless when
// it carried a credential.
func answeredHowPast(requiresKey bool) string {
	if requiresKey {
		return "answered our key"
	}
	return "answered"
}

// firstVerifiedModel is the model an endpoint page builds its snippet from: one
// this endpoint has actually verified, so the printed call is never one the
// endpoint refuses. ModelsFor already orders verified rows first.
func firstVerifiedModel(row ShelfRow, models []ModelRow) (ModelRow, bool) {
	for _, model := range models {
		verdict := model.Verdict(row.RequiresKey())
		if verdict != nil && *verdict && model.ChatCapable {
			return model, true
		}
	}
	return ModelRow{}, false
}

// endpointSnippet and endpointEnvLines build the same blocks the shelf builds,
// from an endpoint row plus one of its models. They go through the same
// derivation the API publishes rather than re-deriving the base URL, which is
// the mistake that put a 404-ing URL on every endpoint page.
func endpointSnippet(row ShelfRow, model ModelRow) string {
	return snippet(workingModelFrom(row, model))
}

func endpointEnvLines(row ShelfRow, model ModelRow) string {
	return EnvLines(workingModelFrom(row, model))
}

func workingModelFrom(row ShelfRow, model ModelRow) WorkingModel {
	return WorkingModel{
		Slug:             row.Slug,
		BaseURL:          row.BaseURL,
		ChatPath:         row.ChatPath,
		AuthMode:         row.AuthMode,
		ModelID:          model.ModelID,
		OpenAICompatible: row.OpenAICompatible,
	}
}

// reliability is shown as a plain fraction rather than a percentage: 2 of 3 is
// honest about the sample size in a way that "67%" is not.
func reliability(successes, attempts int) string {
	if attempts == 0 {
		return "—"
	}
	return fmt.Sprintf("%d/%d", successes, attempts)
}

// dashReason distinguishes the two things a dash can mean. It never becomes a
// "no": a check that ran and got nothing usable back has still not established
// that the feature is absent.
func dashReason(record CapabilityRecord, held bool) string {
	if !held || record.LastChecked == nil {
		return "never checked"
	}
	if record.LastError != "" {
		return "checked " + humanWhenPtr(record.LastChecked) + ", no usable answer: " + truncate(record.LastError, 140)
	}
	return "checked " + humanWhenPtr(record.LastChecked) + ", no usable answer"
}

func orDash(value string) string {
	if strings.TrimSpace(value) == "" {
		return "—"
	}
	return value
}

func latency(ms int) string {
	if ms <= 0 {
		return "—"
	}
	return fmt.Sprintf("%d ms", ms)
}

func statusLabel(status int) string {
	if status == 0 {
		return "—"
	}
	return fmt.Sprint(status)
}

// truncate cuts on a rune boundary. The strings it shortens include model prose
// quoted back from a capability probe, which is not always ASCII, and half a
// character rendered into the page is a mojibake box in somebody's tooltip.
func truncate(value string, limit int) string {
	value = strings.TrimSpace(value)
	if len(value) <= limit {
		return value
	}
	return clipRunes(value, limit) + "…"
}

func humanWhenPtr(at *time.Time) string {
	if at == nil {
		return "never"
	}
	return humanWhen(*at)
}

// humanWhen is deliberately relative. An absolute timestamp invites a reader to
// assume freshness; "3 days ago" does not.
func humanWhen(at time.Time) string {
	if at.IsZero() {
		return "never"
	}
	elapsed := time.Since(at)
	switch {
	case elapsed < time.Minute:
		return "just now"
	case elapsed < time.Hour:
		return fmt.Sprintf("%d min ago", int(elapsed.Minutes()))
	case elapsed < 48*time.Hour:
		return fmt.Sprintf("%d h ago", int(elapsed.Hours()))
	default:
		return fmt.Sprintf("%d days ago", int(elapsed.Hours()/24))
	}
}

// directCallURL and callShape are the two things the page's script needs to make
// a call itself: where to send it, and which body the provider speaks. They are
// computed here rather than in JavaScript so there is one implementation of "how
// do you call this endpoint", not two that can disagree.
func directCallURL(model WorkingModel) string {
	return joinURL(model.BaseURL, model.ChatPath)
}

func callShape(model WorkingModel) string {
	if model.OpenAICompatible {
		return "openai"
	}
	return "ollama"
}

// keyPlaceholder is the name a reader is told to put their own key in. It is
// never a value: ours is ours, and a snippet that looked complete would be
// pasted into a project and fail on the first call with nothing to explain it.
func keyPlaceholder(model WorkingModel) string {
	return "YOUR_" + strings.ToUpper(strings.ReplaceAll(model.Slug, "-", "_")) + "_API_KEY"
}

// snippet is the copyable call. On a key-required row it carries an
// Authorization line with a placeholder the reader has to replace.
//
// The two questions it answers are independent and are asked separately. Which
// body the endpoint speaks is one axis -- mlvoca is Ollama-flavoured, taking a
// bare prompt at /api/generate, and the prober and the test-call route have both
// branched on that since they were written, while this page did not, so an
// endpoint page said "Shape: Ollama, not OpenAI" and printed an OpenAI call ten
// lines below it. Whether the call needs a credential is the other. Nesting them
// dropped the Authorization line from any endpoint that was both, which is a
// snippet that cannot work.
func snippet(model WorkingModel) string {
	authorization := ""
	if model.RequiresKey() {
		authorization = fmt.Sprintf("  -H 'Authorization: Bearer %s' \\\n", keyPlaceholder(model))
	}
	body := fmt.Sprintf(`{"model":"%s","messages":[{"role":"user","content":"hello"}]}`, model.ModelID)
	if !model.OpenAICompatible {
		body = fmt.Sprintf(`{"model":"%s","prompt":"hello","stream":false}`, model.ModelID)
	}
	return fmt.Sprintf("curl %s \\\n%s  -H 'Content-Type: application/json' \\\n  -d '%s'",
		joinURL(model.BaseURL, model.ChatPath), authorization, body)
}

// pythonSnippet and nodeSnippet configure an OpenAI client for one row. Only
// ever rendered for an endpoint that speaks the OpenAI shape -- there is no
// honest way to write these for an Ollama-flavoured one, and inventing them
// would be the paste-and-fail this site exists to complain about.
//
// The key is read from the environment rather than written into the snippet, so
// the only thing that can be copied out of this page is the name of a variable.
func pythonSnippet(model WorkingModel) string {
	key := `"not-needed"`
	preamble := "from openai import OpenAI\n\n"
	if model.RequiresKey() {
		key = fmt.Sprintf(`os.environ[%q]`, keyPlaceholder(model))
		preamble = "import os\n\nfrom openai import OpenAI\n\n"
	}
	return preamble +
		"client = OpenAI(\n" +
		fmt.Sprintf("    base_url=%q,\n", model.OpenAIBaseURL()) +
		"    api_key=" + key + ",\n)\n\n" +
		"print(client.chat.completions.create(\n" +
		fmt.Sprintf("    model=%q,\n", model.ModelID) +
		`    messages=[{"role": "user", "content": "hello"}],` + "\n" +
		").choices[0].message.content)"
}

func nodeSnippet(model WorkingModel) string {
	key := `"not-needed"`
	if model.RequiresKey() {
		key = "process.env." + keyPlaceholder(model)
	}
	return `import OpenAI from "openai";` + "\n\n" +
		"const client = new OpenAI({\n" +
		fmt.Sprintf("  baseURL: %q,\n", model.OpenAIBaseURL()) +
		"  apiKey: " + key + ",\n});\n\n" +
		"const reply = await client.chat.completions.create({\n" +
		fmt.Sprintf("  model: %q,\n", model.ModelID) +
		`  messages: [{ role: "user", content: "hello" }],` + "\n});\n\n" +
		"console.log(reply.choices[0].message.content);"
}

// fallbackLoop is the second half of the pitch: ask the shelf, then walk it.
// Nothing in it is hardcoded but our own URL, which is the whole argument for
// the API existing -- a snippet naming one provider is stale the moment that
// provider changes its mind.
func fallbackLoop(language string, origin string) string {
	api := origin + "/api/llm/up"
	switch language {
	case "python":
		return "import json, urllib.request\n" +
			"from openai import OpenAI\n\n" +
			"shelf = json.load(urllib.request.urlopen(\n" +
			fmt.Sprintf("    %q))\n\n", api) +
			`for endpoint in shelf["models"]:            # already ranked, best first` + "\n" +
			`    client = OpenAI(base_url=endpoint["openai_base_url"],` + "\n" +
			`                    api_key="not-needed")` + "\n" +
			"    try:\n" +
			"        reply = client.chat.completions.create(\n" +
			`            model=endpoint["model"],` + "\n" +
			`            messages=[{"role": "user", "content": "hello"}],` + "\n" +
			"        )\n" +
			"    except Exception:\n" +
			"        continue                           # your IP hit its quota — next\n" +
			`    print(endpoint["model"], reply.choices[0].message.content)` + "\n" +
			"    break"
	case "js":
		return `import OpenAI from "openai";` + "\n\n" +
			fmt.Sprintf("const shelf = await fetch(%q)\n", api) +
			"  .then((response) => response.json());\n\n" +
			"for (const endpoint of shelf.models) {      // already ranked, best first\n" +
			"  const client = new OpenAI({\n" +
			"    baseURL: endpoint.openai_base_url,\n" +
			`    apiKey: "not-needed",` + "\n" +
			"  });\n" +
			"  try {\n" +
			"    const reply = await client.chat.completions.create({\n" +
			"      model: endpoint.model,\n" +
			`      messages: [{ role: "user", content: "hello" }],` + "\n" +
			"    });\n" +
			"    console.log(endpoint.model, reply.choices[0].message.content);\n" +
			"    break;\n" +
			"  } catch { continue; }                    // your IP hit its quota — next\n" +
			"}"
	default:
		return "# whatever your JSON tool is, the two fields you need are the same\n" +
			fmt.Sprintf("read BASE MODEL < <(curl -s %s \\\n", api) +
			`  | jq -r '.models[0] | "\(.openai_base_url) \(.model)"')` + "\n\n" +
			`curl -s "$BASE/chat/completions" \` + "\n" +
			`  -H 'Content-Type: application/json' \` + "\n" +
			`  -d "{\"model\":\"$MODEL\",` + "\n" +
			`       \"messages\":[{\"role\":\"user\",\"content\":\"hello\"}]}"`
	}
}
