package audit

import (
	"fmt"
	"strings"
	"time"
)

templ header() {
	<div class="shelf-nav muted">
		<a href="/">stillworks</a>
		<a href="/llm/">keyless LLM endpoints</a>
		<a href="/llm/keyed/">free tier, key required</a>
		<a href="/mcp/">MCP servers</a>
		<a href="/stats">our traffic</a>
	</div>
}

templ HomePage(working []WorkingModel, keyed []WorkingModel, checked *time.Time, keyedChecked *time.Time) {
	<div class="sw">
		@header()
		<h1>Directories list. We check.</h1>
		<p class="tag">Nothing here is trusted because someone published it. Everything is re-probed, and every claim carries the time it was measured.</p>
		<p class="lede">
			There are more than twenty thousand MCP servers listed across the registries and a
			dozen competing lists of free LLM APIs. Almost none of them are re-tested. A list
			that is never re-probed is a list of things that <em>used to</em> work.
		</p>
		<h2>Free LLM endpoints — no key, no signup</h2>
		<p>
			{ fmt.Sprintf("%d model(s)", len(working)) } verified answering with no API key at all
			if checked != nil {
				<span class="when">, last checked { humanWhen(*checked) }</span>
			}
			. <a href="/llm/">See the shelf</a>, or ask the API:
		</p>
		<pre>curl https://stillworks.supercapybara.com/api/llm/up</pre>
		<h2>Free tier, key required</h2>
		<p>
			{ fmt.Sprintf("%d model(s)", len(keyed)) } on providers whose free tier needs a key, answering
			our own free-tier key
			if keyedChecked != nil {
				<span class="when">, last confirmed { humanWhen(*keyedChecked) }</span>
			}
			. These carry the same record of what happened and when — but a call that works on our key
			is a weaker claim than one that works on no key, and the two are never mixed.
			<a href="/llm/keyed/">See that shelf</a>, or opt in:
		</p>
		<pre>curl 'https://stillworks.supercapybara.com/api/llm/up?auth=key'</pre>
		<p class="muted">
			The plain <code>/api/llm/up</code> above returns keyless endpoints and nothing else. It
			always will: callers wrote that URL down when it was the only shelf here.
		</p>
		<h2>MCP servers</h2>
		<p class="muted">Not open yet. The LLM shelf ships first and has to earn its keep before the second one starts.</p>
	</div>
}

// workingHeader and endpointHeader make a column heading a link that sorts by
// it. A link rather than a button: the sorted table has an address, so it can be
// bookmarked, shared, and read by something with no JavaScript at all.
templ workingHeader(query ShelfQuery, key string, label string) {
	<th>
		<a class="sort" href={ templ.SafeURL(query.WorkingSortLink(key)) }>
			{ label }{ query.WorkingSortMark(key) }
		</a>
	</th>
}

templ endpointHeader(query ShelfQuery, key string, label string) {
	<th>
		<a class="sort" href={ templ.SafeURL(query.EndpointSortLink(key)) }>
			{ label }{ query.EndpointSortMark(key) }
		</a>
	</th>
}

// shelfFilters is a plain GET form. The current sort travels in hidden fields
// because a form submits only its own inputs, and losing the sort on every
// filter change is the kind of small betrayal that makes a control feel broken.
templ shelfFilters(query ShelfQuery, slugs []string, auth string) {
	<form class="filters" method="get" action={ templ.SafeURL(shelfPathFor(auth)) }>
		<label>
			Endpoint
			<select name="endpoint">
				<option value="" selected?={ query.Endpoint == "" }>every endpoint</option>
				for _, slug := range slugs {
					<option value={ slug } selected?={ query.Endpoint == slug }>{ slug }</option>
				}
			</select>
		</label>
		<label>
			Model contains
			<input type="search" name="q" value={ query.Search } placeholder="gpt, llama, mistral"/>
		</label>
		// This one only narrows the endpoint table below. The table above is
		// verified by definition, so a filter that could widen it would make the
		// same heading mean two different things.
		<label>
			Endpoints (below)
			<select name="keyless">
				<option value="" selected?={ query.Keyless == "" }>either way</option>
				<option value="yes" selected?={ query.Keyless == "yes" }>{ "has a model that answered " + answeredHow(auth) }</option>
				<option value="no" selected?={ query.Keyless == "no" }>{ "none verified " + answeredHow(auth) }</option>
			</select>
		</label>
		<input type="hidden" name="sort" value={ query.WorkingSort }/>
		<input type="hidden" name="order" value={ query.WorkingOrder }/>
		<input type="hidden" name="endpoint_sort" value={ query.EndpointSort }/>
		<input type="hidden" name="endpoint_order" value={ query.EndpointOrder }/>
		<button type="submit">Apply</button>
		if query.Filtered() {
			<a class="clear" href="/llm/">Clear</a>
		}
	</form>
}

// ShelfPage renders either shelf. One component rather than two because the
// tables, sorting and filtering are identical machinery -- but every sentence
// that makes a claim is chosen by the auth mode, because the claims are not
// identical at all and a shared page that read the same on both would be worse
// than no second shelf.
templ ShelfPage(
	rows []ShelfRow,
	working []WorkingModel,
	drawing []WorkingModel,
	query ShelfQuery,
	slugs []string,
	auth string,
	configured bool,
) {
	<div class="sw">
		@header()
		if auth == AuthModeKey {
			<h1>Free tier, key required</h1>
			<p class="tag">
				These need an API key. They are here because we re-probe them and publish what
				happened — not because they are free to call without signing up.
			</p>
			<p class="warn">
				Every result on this page was produced by a call carrying <strong>our own</strong>
				free-tier key, from this server's address. It proves the endpoint answered our
				account at the time shown. It is <strong>not</strong> a measurement of what your
				signup's free tier includes, what quota you get, or whether the provider is still
				handing out free accounts. We cannot measure any of that for you.
			</p>
			<p class="muted">
				Looking for endpoints that need no key and no signup at all? That is the
				<a href="/llm/">keyless shelf</a>, and it is the one this site is really about.
			</p>
		} else {
			<h1>Free LLM endpoints</h1>
			<p class="tag">Keyless only. No key, no signup, nothing to sign up for.</p>
			<p class="muted">
				Verified from this server's IP address, by calls carrying no Authorization header at
				all. Keyless quotas are usually per-IP, so an endpoint that answers here can still
				return 402 or 429 from yours — which is why the <strong>Worked</strong> column is
				worth more than the last green tick, and why every row has a <strong>Test</strong>
				button that calls it from <em>your</em> address.
			</p>
			<p class="muted">
				Providers whose free tier wants a key are on a
				<a href="/llm/keyed/">separate shelf</a>, kept separate on purpose.
			</p>
		}
		@shelfFilters(query, slugs, auth)
		<h2>Working right now</h2>
		if len(working) == 0 {
			if query.Filtered() {
				<p class="muted">
					{ "No verified model matches that filter. " }
					<a href={ templ.SafeURL(shelfPathFor(auth)) }>Show every one.</a>
				</p>
			} else if !configured {
				// Not a fact about the providers. This instance holds no key
				// for anything on this shelf, so it has not called them, and
				// saying "nothing is verified" would blame somebody else's
				// service for our own missing configuration.
				<p class="warn">
					This instance holds no API key for any provider on this shelf, so it has not called
					any of them. Nothing here is a statement about whether those providers are working.
				</p>
			} else {
				<p class="muted">
					{ "Nothing on this shelf is currently verified " + answeredHow(auth) + ". That is a real answer, not a loading state." }
				</p>
			}
		} else {
			<div class="scroll">
				<table>
					<thead>
						<tr>
							@workingHeader(query, "model", "Model")
							@workingHeader(query, "endpoint", "Endpoint")
							<th class="feature">Tier</th>
							<th class="feature">Tools</th><th class="feature">Schema</th><th class="feature">JSON</th><th class="feature">Vision</th>
							@workingHeader(query, "latency", "Latency")
							@workingHeader(query, "reliability", "Worked")
							@workingHeader(query, "verified", "Verified")
							if auth != AuthModeKey {
								<th>Test</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, model := range working {
							<tr>
								<td><code>{ model.ModelID }</code></td>
								<td><a href={ templ.SafeURL("/llm/" + model.Slug) }>{ model.Slug }</a></td>
								<td class="muted feature">{ orDash(model.Tier) }</td>
								for _, capability := range ChatCapabilities {
									@capabilityCell(model.Capabilities, capability)
								}
								<td class="when">{ latency(model.LatencyMS) }</td>
								<td class="when">{ reliability(model.Successes, model.Attempts) }</td>
								<td class="when">{ humanWhenPtr(model.LastOK) }</td>
								// The test button is keyless-only. On this shelf the
								// call could only be made on our key, which would be
								// free inference handed out on our quota and would
								// prove nothing the row does not already say.
								if auth != AuthModeKey {
									<td>
										@tryForm(model)
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="muted">
				A feature column says what a real call proved, not what the provider's own
				listing claims. A dash is a question nobody has asked yet, which is never the
				same as a no. Ask the API for the ones you need:
			</p>
			<p class="muted narrow-only">
				The feature columns are folded away at this width. Open an endpoint to see the
				full matrix, or ask the API.
			</p>
			<pre>{ featureQueryExample(auth) }</pre>
			<h2>Call one</h2>
			if auth == AuthModeKey {
				<p class="muted">
					With your own key from that provider. Ours is never rendered on this site, returned
					by its API, or written into its database — it lives in the deployment's environment
					and goes out on probes only.
				</p>
			}
			<pre>{ snippet(working[0]) }</pre>
		}
		<h2>Image generation</h2>
		if len(drawing) == 0 {
			<p class="muted">{ "No image endpoint on this shelf is currently verified " + answeredHow(auth) + "." }</p>
		} else {
			<table>
				<thead>
					<tr><th>Model</th><th>Endpoint</th><th>Draws</th><th>Verified</th></tr>
				</thead>
				<tbody>
					for _, model := range drawing {
						<tr>
							<td><code>{ model.ModelID }</code></td>
							<td><a href={ templ.SafeURL("/llm/" + model.Slug) }>{ model.Slug }</a></td>
							@capabilityCell(model.Capabilities, CapabilityImageOut)
							<td class="when">{ humanWhenPtr(model.LastOK) }</td>
						</tr>
					}
				</tbody>
			</table>
			<p class="muted">
				Verified by asking for a picture and checking the bytes that came back are
				really an image, not by trusting a 200.
			</p>
		}
		<h2>Every endpoint we track</h2>
		if len(rows) == 0 {
			<p class="muted">
				{ "No tracked endpoint on this shelf matches that filter. " }
				<a href={ templ.SafeURL(shelfPathFor(auth)) }>Show every one.</a>
			</p>
		} else {
			<div class="scroll">
				<table>
					<thead>
						<tr>
							@endpointHeader(query, "endpoint", "Endpoint")
							<th>Last result</th>
							@endpointHeader(query, "listed", "Models listed")
							if auth == AuthModeKey {
								@endpointHeader(query, "keyless", "Answered our key")
								<th>Refused our key</th>
							} else {
								@endpointHeader(query, "keyless", "Keyless")
								<th>Key required</th>
							}
							@endpointHeader(query, "checked", "Checked")
						</tr>
					</thead>
					<tbody>
						for _, row := range rows {
							<tr>
								<td>
									<a href={ templ.SafeURL("/llm/" + row.Slug) }>{ row.Slug }</a>
									<div class="muted">{ row.Provider }</div>
								</td>
								<td><span class={ outcomeClass(row.Outcome) }>{ row.Outcome }</span></td>
								<td>{ fmt.Sprint(row.ModelsListed) }</td>
								<td>{ fmt.Sprint(row.WorkingModels) }</td>
								<td>{ fmt.Sprint(row.KeyOnlyModels) }</td>
								<td class="when">{ humanWhenPtr(row.CheckedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// tryForm submits to /llm/try with no JavaScript at all, which runs the call
// from this server. The page's script upgrades it in place: it makes the same
// call from the visitor's own browser, which is the only version that answers
// the question a per-IP quota actually raises. The data attributes are what the
// script needs to build that request; without the script they are inert.
templ tryForm(model WorkingModel) {
	<form
		class="try"
		method="get"
		action="/llm/try"
		data-url={ directCallURL(model) }
		data-shape={ callShape(model) }
		data-model={ model.ModelID }
	>
		<input type="hidden" name="endpoint" value={ model.Slug }/>
		<input type="hidden" name="model" value={ model.ModelID }/>
		<button type="submit">Test call</button>
	</form>
}

templ EndpointPage(row ShelfRow, models []ModelRow, probes []ProbeRow) {
	<div class="sw">
		@header()
		<h1>{ row.Slug }</h1>
		<p class="tag">
			{ row.Provider } —
			<code>{ row.BaseURL }</code>
			if row.DocsURL != "" {
				— <a href={ templ.SafeURL(row.DocsURL) } rel="nofollow noopener">docs</a>
			}
		</p>
		if row.RequiresKey() {
			<p class="warn">
				This provider requires an API key. Every row below was measured with stillworks' own
				free-tier key, from this server's address, at the time shown. That says the endpoint
				answered <em>our</em> account — it says nothing about what a new signup's free tier
				includes, and we have no way to measure that for you. Our key is never shown here,
				returned by the API, or stored in the database.
			</p>
		}
		if row.Notes != "" {
			<p class="lede muted">{ row.Notes }</p>
		}
		<h2>Models</h2>
		<div class="scroll">
			<table>
				<thead>
					<tr>
						<th>Model</th><th>Tier</th>
						if row.RequiresKey() {
							<th>Answers our key</th>
						} else {
							<th>Keyless</th>
						}
						<th>Chat</th>
						<th>Tools</th><th>Schema</th><th>JSON</th><th>Vision</th><th>Images</th>
						<th>Worked</th><th>Last checked</th><th>Last listed</th>
					</tr>
				</thead>
				<tbody>
					for _, model := range models {
						<tr>
							<td><code>{ model.ModelID }</code></td>
							<td class="muted">{ orDash(model.Tier) }</td>
							<td>{ verdictLabel(model.Verdict(row.RequiresKey()), row.RequiresKey()) }</td>
							<td class="muted">
								if model.ChatCapable {
									yes
								} else {
									not a chat model
								}
							</td>
							for _, capability := range Capabilities {
								@capabilityCell(model.Capabilities, capability)
							}
							<td class="when">{ reliability(model.Successes, model.Attempts) }</td>
							<td class="when">{ humanWhenPtr(model.LastChecked) }</td>
							<td class="when">{ humanWhen(model.LastSeen) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="muted">
			Feature columns are measurements. Where the provider's own listing claims a
			feature we could not get out of it, the cell says so — that disagreement is the
			reason this shelf exists.
		</p>
		<h2>Raw probe log</h2>
		<p class="muted">Our working, so you can check it rather than trust it.</p>
		// Wrapped like the models table above it. Without this the detail column
		// -- which quotes the provider's own error back -- pushes the whole
		// document wider than a phone screen, so every page on the site scrolls
		// sideways rather than this one table doing it. It was already true of
		// every endpoint page before the second shelf existed.
		<div class="scroll">
			<table>
				<thead>
					<tr><th>When</th><th>Kind</th><th>Outcome</th><th>HTTP</th><th>Latency</th><th>Model</th><th>Detail</th></tr>
				</thead>
				<tbody>
					for _, probe := range probes {
						<tr>
							<td class="when">{ humanWhen(probe.StartedAt) }</td>
							<td>{ probe.Kind }</td>
							<td><span class={ outcomeClass(probe.Outcome) }>{ probe.Outcome }</span></td>
							<td>{ statusLabel(probe.HTTPStatus) }</td>
							<td class="when">{ latency(probe.LatencyMS) }</td>
							<td><code>{ orDash(probe.ModelUsed) }</code></td>
							<td class="muted">{ truncate(probe.Error, 90) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ StatsPage(report TrafficReport, dropped int64) {
	<div class="sw">
		@header()
		<h1>Our own numbers</h1>
		<p class="tag">
			This site's whole claim is that a directory should publish what it measured and when.
			That standard applies to its own traffic too.
		</p>
		<div class="stats">
			<div class="stat">
				<span class="stat-n">{ fmt.Sprint(report.Totals.APICalls) }</span>
				<span class="stat-l">runtime API calls</span>
			</div>
			<div class="stat">
				<span class="stat-n">{ fmt.Sprint(report.Totals.Sessions) }</span>
				<span class="stat-l">visitors</span>
			</div>
			<div class="stat">
				<span class="stat-n">{ fmt.Sprint(report.Totals.PageViews) }</span>
				<span class="stat-l">page views</span>
			</div>
			<div class="stat">
				<span class="stat-n">{ fmt.Sprint(report.Totals.APIClients) }</span>
				<span class="stat-l">distinct API clients</span>
			</div>
		</div>
		<p class="muted">
			All-time, since { humanWhenPtr(report.Totals.FirstAt) }.
			if report.Totals.CrawlerHits > 0 {
				{ fmt.Sprintf("%d crawler hit(s) recorded and excluded from every count above.", report.Totals.CrawlerHits) }
			}
			if report.Totals.InternalHits > 0 {
				{ fmt.Sprintf("%d request(s) from our own deploy checks and tests, also excluded.", report.Totals.InternalHits) }
			}
		</p>
		<h2>{ fmt.Sprintf("Last %d days", statsDays) }</h2>
		if len(report.Days) == 0 {
			<p class="muted">Nothing recorded yet. That is a real answer, not a loading state.</p>
		} else {
			<table>
				<thead>
					<tr><th>Day (UTC)</th><th>Visitors</th><th>Page views</th><th>API calls</th></tr>
				</thead>
				<tbody>
					for _, day := range report.Days {
						<tr>
							<td class="when">{ day.Day.Format("2006-01-02") }</td>
							<td>{ fmt.Sprint(day.Sessions) }</td>
							<td>{ fmt.Sprint(day.PageViews) }</td>
							<td>{ fmt.Sprint(day.APICalls) }</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<h2>Where visitors came from</h2>
		if len(report.Referrers) == 0 {
			<p class="muted">No referring host has sent anybody yet.</p>
		} else {
			<table>
				<thead>
					<tr><th>Referring host</th><th>Hits</th><th>Visitors</th></tr>
				</thead>
				<tbody>
					for _, referrer := range report.Referrers {
						<tr>
							<td>{ referrer.Host }</td>
							<td>{ fmt.Sprint(referrer.Hits) }</td>
							<td>{ fmt.Sprint(referrer.Visitors) }</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<h2>What was asked for</h2>
		if len(report.Paths) == 0 {
			<p class="muted">Nothing yet.</p>
		} else {
			<table>
				<thead>
					<tr><th>Path</th><th>Kind</th><th>Hits</th></tr>
				</thead>
				<tbody>
					for _, path := range report.Paths {
						<tr>
							<td><code>{ path.Path }</code></td>
							<td class="muted">{ path.Kind }</td>
							<td>{ fmt.Sprint(path.Hits) }</td>
						</tr>
					}
				</tbody>
			</table>
		}
		<h2>How this is counted</h2>
		<ul class="muted">
			<li>
				A visitor is one salted hash of address and user agent, on one UTC day. The hash
				input includes the date, so it cannot be followed from one day to the next, and
				the address itself is never written down.
			</li>
			<li>Requests to this page and to <code>/api/stats</code> are never counted. Reading the scoreboard must not move it.</li>
			<li>Crawlers are recorded and excluded. Deleting them would hide a traffic source; counting them would turn a search engine into an audience.</li>
			<li>
				Our own requests are recorded and excluded too — deploy checks, browser tests, the
				machine this is built on. These numbers decide whether the project continues, and
				counting our own work as demand is the most comfortable way to get that decision
				wrong.
			</li>
			<li>Counts are written from a bounded in-memory buffer, so a restart can lose up to two seconds of events.</li>
			if dropped > 0 {
				<li class="warn">{ fmt.Sprintf("%d event(s) were dropped because the write buffer was full. Under-counting is reported, never hidden.", dropped) }</li>
			}
		</ul>
		<p class="muted">Same numbers as JSON: <code>curl https://stillworks.supercapybara.com/api/stats</code></p>
	</div>
}

// capabilityCell renders one feature verdict. A capability nobody has asked
// about renders as a dash and never as a "no": the whole tri-state exists so
// that "we have not checked" and "it does not work" stay different answers.
// The feature column is marked so a narrow screen can fold these four away.
// They are the widest part of a row and the least urgent: a phone visitor wants
// to know what answers and to press the button, and the full matrix is one tap
// away on the endpoint page.
templ capabilityCell(records map[string]CapabilityRecord, capability string) {
	if record, held := records[capability]; !held || record.Supported == nil {
		<td class="muted feature" title="never verified">—</td>
	} else if *record.Supported {
		<td class="ok feature" title={ "verified " + humanWhenPtr(record.LastOK) }>yes</td>
	} else if record.ClaimContradicted() {
		<td class="bad feature" title={ truncate(record.LastError, 160) }>no, claimed</td>
	} else {
		<td class="bad feature" title={ truncate(record.LastError, 160) }>no</td>
	}
}

// TryPage is what a visitor sees with JavaScript switched off, or when their
// browser could not reach the provider directly. Its first job is to be honest
// about whose address made the call, because a result presented without that is
// a different claim from the one it looks like.
templ TryPage(result TryResult) {
	<div class="sw">
		@header()
		<h1>Test call</h1>
		<p class="tag">
			<code>{ result.Model }</code> on
			<a href={ templ.SafeURL("/llm/" + result.Endpoint) }>{ result.Endpoint }</a>
		</p>
		if !result.Made() {
			<p class="lede warn">No call was made.</p>
			<p class="muted">{ result.Refused }</p>
		} else {
			<p class="lede bad">
				This call was made from { result.From } — not from yours.
			</p>
			<p class="muted">
				Keyless quotas are commonly per-IP, so this tells you the endpoint answered
				<em>us</em>. Your own address can get 402 or 429 for the same request. Run the
				snippet below to find out, or open this page with JavaScript enabled and the
				call is made by your browser instead.
			</p>
			<table class="result">
				<tbody>
					<tr><th>Outcome</th><td><span class={ outcomeClass(result.Outcome) }>{ result.Outcome }</span></td></tr>
					<tr><th>HTTP</th><td>{ statusLabel(result.HTTPStatus) }</td></tr>
					<tr><th>Latency</th><td class="when">{ latency(result.LatencyMS) }</td></tr>
					<tr><th>Called at</th><td class="when">{ result.CalledAt.Format("2006-01-02 15:04:05") } UTC ({ humanWhen(result.CalledAt) })</td></tr>
					<tr><th>Called from</th><td>{ result.From }</td></tr>
					<tr><th>Prompt</th><td><code>{ result.Prompt }</code></td></tr>
				</tbody>
			</table>
			if result.Answer != "" {
				<h2>What it said</h2>
				<pre>{ result.Answer }</pre>
			}
			if result.Detail != "" {
				<h2>What came back instead</h2>
				<pre>{ result.Detail }</pre>
			}
			<h2>The same call, from your machine</h2>
			<pre>{ trySnippet(result) }</pre>
		}
		<h2>Ask it something else</h2>
		<form class="filters" method="get" action="/llm/try">
			<input type="hidden" name="endpoint" value={ result.Endpoint }/>
			<input type="hidden" name="model" value={ result.Model }/>
			<label>
				Prompt
				<input type="text" name="prompt" value={ result.Prompt } maxlength={ fmt.Sprint(tryPromptLimit) }/>
			</label>
			<button type="submit">Call again</button>
		</form>
		<p class="muted">
			{ fmt.Sprintf("Prompts are capped at %d characters and answers at %d tokens.", tryPromptLimit, tryMaxTokens) }
			This is a demonstration that the endpoint answers, not a free inference service.
		</p>
		<p><a href="/llm/">Back to the shelf</a></p>
	</div>
}

templ NotFoundPage(what string) {
	<div class="sw">
		@header()
		<h1>Not here</h1>
		<p class="muted">{ what }</p>
	</div>
}

templ ComingSoonPage() {
	<div class="sw">
		@header()
		<h1>MCP servers</h1>
		<p class="lede">
			Twenty thousand servers are listed across the registries and you cannot know what any
			of them exposes without running it. That shelf will record what each one actually
			does: whether it starts, which tools it registers, and which secrets it demands.
		</p>
		<p class="muted">Not open yet. The LLM shelf ships first and has to earn its keep.</p>
	</div>
}

func outcomeClass(outcome string) string {
	switch outcome {
	case OutcomeOK:
		return "ok"
	case OutcomeNeedsKey, OutcomeBlocked, OutcomeUnreachable, OutcomeServerError, OutcomeBadBody:
		return "bad"
	case OutcomeRateLimited, OutcomeTimeout, OutcomeClientError:
		return "warn"
	default:
		return "muted"
	}
}

// verdictLabel words the same tri-state for both shelves. The words differ
// because the fact differs: "yes" on the keyless shelf means anybody can call
// it, and on the keyed shelf it means our key was accepted.
func verdictLabel(verdict *bool, requiresKey bool) string {
	switch {
	case verdict == nil:
		return "not yet checked"
	case *verdict && requiresKey:
		return "yes, on our key"
	case *verdict:
		return "yes"
	case requiresKey:
		return "refused our key"
	default:
		return "needs a key"
	}
}

// answeredHow is the phrase that finishes "verified …" on each shelf. It exists
// so no page can end up saying "verified keyless" about a row that was measured
// with a credential.
func answeredHow(auth string) string {
	if auth == AuthModeKey {
		return "on our key"
	}
	return "keyless"
}

// featureQueryExample keeps the copyable curl line on each shelf pointed at
// that shelf. Without the auth parameter the keyed page would print an example
// that returns keyless results, which is a working command that answers the
// wrong question.
func featureQueryExample(auth string) string {
	const base = "curl 'https://stillworks.supercapybara.com/api/llm/up?feature=tools,json_schema"
	if auth == AuthModeKey {
		return base + "&auth=key'"
	}
	return base + "'"
}

// reliability is shown as a plain fraction rather than a percentage: 2 of 3 is
// honest about the sample size in a way that "67%" is not.
func reliability(successes, attempts int) string {
	if attempts == 0 {
		return "—"
	}
	return fmt.Sprintf("%d/%d", successes, attempts)
}

func orDash(value string) string {
	if strings.TrimSpace(value) == "" {
		return "—"
	}
	return value
}

func latency(ms int) string {
	if ms <= 0 {
		return "—"
	}
	return fmt.Sprintf("%d ms", ms)
}

func statusLabel(status int) string {
	if status == 0 {
		return "—"
	}
	return fmt.Sprint(status)
}

// truncate cuts on a rune boundary. The strings it shortens now include model
// prose quoted back from a capability probe, which is not always ASCII, and half
// a character rendered into the page is a mojibake box in somebody's tooltip.
func truncate(value string, limit int) string {
	value = strings.TrimSpace(value)
	if len(value) <= limit {
		return value
	}
	return clipRunes(value, limit) + "…"
}

func humanWhenPtr(at *time.Time) string {
	if at == nil {
		return "never"
	}
	return humanWhen(*at)
}

// humanWhen is deliberately relative. An absolute timestamp invites a reader to
// assume freshness; "3 days ago" does not.
func humanWhen(at time.Time) string {
	if at.IsZero() {
		return "never"
	}
	elapsed := time.Since(at)
	switch {
	case elapsed < time.Minute:
		return "just now"
	case elapsed < time.Hour:
		return fmt.Sprintf("%d min ago", int(elapsed.Minutes()))
	case elapsed < 48*time.Hour:
		return fmt.Sprintf("%d h ago", int(elapsed.Hours()))
	default:
		return fmt.Sprintf("%d days ago", int(elapsed.Hours()/24))
	}
}

// directCallURL and callShape are the two things the page's script needs to
// make the call itself: where to send it, and which body the provider speaks.
// They are computed here rather than in JavaScript so there is one
// implementation of "how do you call this endpoint", not two that can disagree.
func directCallURL(model WorkingModel) string {
	return joinURL(model.BaseURL, model.ChatPath)
}

func callShape(model WorkingModel) string {
	if model.OpenAICompatible {
		return "openai"
	}
	return "ollama"
}

// trySnippet reproduces exactly the request that was just made, so a visitor can
// run it from their own address and compare. The prompt is the one they sent.
func trySnippet(result TryResult) string {
	return fmt.Sprintf(`curl %s \
  -H 'Content-Type: application/json' \
  -d '{"model":"%s","messages":[{"role":"user","content":"%s"}],"max_tokens":%d}'`,
		result.URL, result.Model, escapeForShellJSON(result.Prompt), tryMaxTokens)
}

// escapeForShellJSON keeps a pasted prompt from breaking out of either the JSON
// string or the surrounding single-quoted shell argument.
func escapeForShellJSON(prompt string) string {
	replacer := strings.NewReplacer(`\`, `\\`, `"`, `\"`, "'", `'"'"'`, "\n", " ")
	return replacer.Replace(prompt)
}

// snippet is the copyable call. On the keyed shelf it carries an Authorization
// line with a placeholder the reader has to replace: a snippet that looked
// complete would be pasted straight into a project and fail on the first call,
// and there is no honest way to fill it in for them -- our key is ours.
func snippet(model WorkingModel) string {
	if model.RequiresKey() {
		return fmt.Sprintf(`curl %s%s \
  -H 'Authorization: Bearer YOUR_%s_API_KEY' \
  -H 'Content-Type: application/json' \
  -d '{"model":"%s","messages":[{"role":"user","content":"hello"}]}'`,
			strings.TrimSuffix(model.BaseURL, "/"), model.ChatPath,
			strings.ToUpper(strings.ReplaceAll(model.Slug, "-", "_")), model.ModelID)
	}
	return fmt.Sprintf(`curl %s%s \
  -H 'Content-Type: application/json' \
  -d '{"model":"%s","messages":[{"role":"user","content":"hello"}]}'`,
		strings.TrimSuffix(model.BaseURL, "/"), model.ChatPath, model.ModelID)
}
